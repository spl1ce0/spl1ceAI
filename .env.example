# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
PORT=8080

# AI Model Provider API Keys (Fill in the ones you use)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
XAI_API_KEY=your_xai_grok_api_key_here

# Polar.sh Subscription & Billing (Optional / Production)
# See cogs/billing/README.md for details
POLAR_ACCESS_TOKEN=polar_at_your_access_token_here
POLAR_PRODUCT_ID=your_product_id_here
POLAR_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# GitHub Integration (Optional - for owner-only /idea command)
# Fine-grained PAT with Issues (Read and write) permission on spl1ce0/spl1ceAI
GITHUB_TOKEN=your_github_fine_grained_pat_here
